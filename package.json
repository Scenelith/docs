{
  "name": "@scenelith/docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "build": "npm run check:product-coverage && docusaurus build",
    "serve": "docusaurus serve --host 0.0.0.0",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "sync:product-reference": "node scripts/sync-product-reference.mjs",
    "check:product-coverage": "node scripts/check-product-coverage.mjs"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
